rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'pcnghi2015@gmail.com'
            || request.auth.token.email == 'ssv2400231@student.sedbergh.edu.vn');
    }

    // Mỗi người chỉ đọc/ghi dữ liệu game của chính mình; chỉ chủ tài khoản đọc được danh sách người chơi
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Dấu mốc đăng nhập: mỗi tài khoản một document (chỉ có thời điểm), admin và chủ tài khoản đếm được
    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;   // cập nhật "seen" (online) và tên
      allow delete: if false;
    }

    // Mật khẩu admin (hash SHA-256) — không ai đọc được từ trình duyệt
    match /config/{docId} {
      allow read, write: if false;
    }

    // Danh sách admin: người có tài khoản tự nhập đúng mật khẩu để tạo quyền của chính mình;
    // chỉ chủ tài khoản được xem toàn bộ danh sách và xóa (kick) quyền admin
    // Danh sách cấm nhập mật khẩu: chủ tài khoản thêm/xóa, người bị cấm chỉ biết trạng thái của mình
    match /bans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow create, delete: if isOwner();
      allow update: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.passHash == get(/databases/$(database)/documents/config/admin).data.hash
        && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
      allow delete: if isOwner();
      allow update: if false;
    }
  }
}
